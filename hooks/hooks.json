{
  "_comment": "flywheel factory event log. OPT-IN: pg-log.sh exits immediately unless ~/.local/state/pg-factory/ exists, so installing this plugin changes nothing until you run `mkdir -p ~/.local/state/pg-factory`. Only the six events both Claude Code and Droid document are registered, so one file serves both harnesses. PostToolUse deliberately carries NO matcher: Claude Code reads the matcher as a regex and matches every tool when it is omitted, and Droid matches all tools too (verified 2026-09-01 \u2014 a `matcher: \"*\"` entry logged nothing on Claude Code, and carrying both an omitted-matcher and a `*` entry made Droid fire twice for one call).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '${CLAUDE_PLUGIN_ROOT}/hooks/pg-log.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
